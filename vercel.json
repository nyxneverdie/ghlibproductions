{
  "version": 2,
  "outputDirectory": "frontend/build",
  "buildCommand": "npm install --no-audit --no-fund && cd frontend && yarn install --network-timeout 600000 && yarn build",
  "installCommand": "echo skip",
  "functions": { "api/index.py": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth-handler?auth_path=:path*" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/((?!api/|static/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
